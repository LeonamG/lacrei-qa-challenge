{
  "name": "lacrei-saude",
  "version": "1.0.0",
  "description": "testes Cypress lacrei",
  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "test:login": "cypress run --spec 'cypress/e2e/features/login.feature'",
    "test:pesquisa": "cypress run --spec 'cypress/e2e/features/pesquisa.feature'",
    "test:agendamento": "cypress run --spec 'cypress/e2e/features/agendamento.feature'"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^24.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "cypress": "^15.11.0",
    "cypress-axe": "^1.7.0",
    "esbuild": "^0.27.4"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/steps/**/*.js"
    ]
  },
  "dependencies": {
    "lighthouse": "^13.0.3",
    "puppeteer": "^24.39.0"
